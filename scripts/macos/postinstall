#!/bin/bash
APP_PATH="/Applications/Qur'an Tarteel Hifz.app"
if [ ! -d "$APP_PATH" ]; then
  APP_PATH=$(find /Applications -maxdepth 1 -name "*quran*tarteel*.app" -o -name "*Quran*Tarteel*.app" | head -n 1)
fi
if [ -n "$APP_PATH" ] && [ -d "$APP_PATH" ]; then
  xattr -cr "$APP_PATH" 2>/dev/null || true
fi
exit 0
